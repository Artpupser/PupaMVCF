{
  "$schema": "http://json.schemastore.org/template",
  "author": "Artpupser",
  "classifications": [
    "web",
    "framework",
    "mvc"
  ],
  "identity": "PupaMVCF.Template",
  "name": "Template for PupaMVCF",
  "sourceName": "PupaMVCF.Template",
  "shortName": "pupamvcf-app",
  "defaultName": "PupaMVCF.App",
  "description": "Template for working with PupaMVCF.Framework",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "source": "./src",
      "target": "./"
    }
  ],
  "preferNameDirectory": true,
  "symbols": {
    "PUPA_FRAMEWORK_VERSION": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.2.3",
      "replaces": "FrameworkVersion"
    }
  }
}