<Project Sdk="Microsoft.NET.Sdk.Worker">
    <PropertyGroup>
        <PackageType>Template</PackageType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>PupaMVCF.Template</PackageId>
        <Version>0.2.2</Version>
        <PackageTags>dotnet-new;template;web;mvc;pupamvcf</PackageTags>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <EnableDefaultContentItems>false</EnableDefaultContentItems>
        <NoWarn>NU5128</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <Content Include=".template.config\**" />
        <Content Include="**\*" Exclude="bin\**;obj\**;.template.config\**" />
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
    <ItemGroup>
        <FilesProject Include="$(ProjectDir)/environment/**/*"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="dotenv.net" Version="4.0.2"/>
        <PackageReference Include="Npgsql" Version="10.0.2"/>
        <ProjectReference Include="PupaMVCF.Framework" Version="PUPA_FRAMEWORK_VERSION"/>
    </ItemGroup>
    <Target Name="BuildEnv" AfterTargets="Build">
        <Copy SourceFiles="@(FilesProject)" DestinationFolder="$(TargetDir)/%(RecursiveDir)"/>
    </Target>
    <Target Name="PublishEnv" AfterTargets="Publish">
        <Copy SourceFiles="@(FilesProject)" DestinationFolder="$(PublishDir)/%(RecursiveDir)"/>
    </Target>
</Project>
